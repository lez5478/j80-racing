# Installed packages — Pages won't run npm; the generators run locally.
node_modules/

# Sail-records VTK files: too large for Git, they'll live in R2 in phase 2.
# Comment this out if you want to ship them with the repo (smaller fleets).
Sail\ records/

# PDF cache — generated by race-results/fetch.js; safe to skip.
race-results/20*/

# Any stray PDFs dropped at the root of the repo (e.g. example uploads).
*.pdf

# Raw wind-text snapshots — regenerated hourly by wind/fetch-text.js.
wind/text/

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Anything temp
*.log
*.tmp

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
