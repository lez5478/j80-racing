{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "j80-racing",
  "main": "_worker.js",
  "compatibility_date": "2026-04-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "SAIL_RECORDS",
      "bucket_name": "sail-records"
    }
  ]
}
